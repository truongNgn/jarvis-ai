FROM python:3.12.15-slim-bookworm@sha256:34386ef0cb081344d7ec1c103ba398e6e9f64e9ab3a1509accc92a4e24a07258 AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app/src LANGSMITH_TRACING=false
WORKDIR /app
COPY requirements.lock ./
RUN pip install --no-cache-dir --disable-pip-version-check -r requirements.lock && pip check
COPY src ./src
COPY pyproject.toml ./
RUN useradd --uid 10001 --create-home jarvis
USER jarvis
ENTRYPOINT ["python", "-m", "jarvis.ui.cli"]

FROM runtime AS test
USER root
COPY requirements-dev.lock ./
RUN pip install --no-cache-dir --disable-pip-version-check -r requirements-dev.lock && pip check
COPY tests ./tests
COPY evals ./evals
USER jarvis
ENTRYPOINT ["python", "-m", "pytest", "-q", "tests"]
